class Kargo < Formula
  desc "Cargo for Kotlin: a build tool and package manager"
  homepage "https://enekocm7.github.io/kargo/"
  version "@VERSION@"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    on_arm do
      url "https://github.com/enekocm7/kargo/releases/download/v@VERSION@/kargo-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_aarch64_apple_darwin@"
    end
    on_intel do
      url "https://github.com/enekocm7/kargo/releases/download/v@VERSION@/kargo-@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA_x86_64_apple_darwin@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/enekocm7/kargo/releases/download/v@VERSION@/kargo-@VERSION@-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_aarch64_unknown_linux_musl@"
    end
    on_intel do
      url "https://github.com/enekocm7/kargo/releases/download/v@VERSION@/kargo-@VERSION@-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_x86_64_unknown_linux_musl@"
    end
  end

  def install
    bin.install "kargo"
    generate_completions_from_executable(bin/"kargo", "completions", shells: [:bash, :zsh, :fish])
  end

  test do
    assert_match "kargo #{version}", shell_output("#{bin}/kargo --version")
  end
end
